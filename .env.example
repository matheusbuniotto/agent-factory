# Copy to .env and fill in. Never commit .env.
# Load it with `set -a; source .env; set +a`, or `docker run --env-file .env ...`.

# Models (default provider for planner, implementer, reviewer and scribe)
ANTHROPIC_API_KEY=

# Optional: OpenAI models ("openai:<model>" in factory.toml)
OPENAI_API_KEY=

# Optional: a self-hosted OpenAI-compatible endpoint. The name must match
# `api_key_env` under [endpoints.<name>] in factory.toml.
LOCAL_API_KEY=

# Optional: push branches and open pull requests with `gh`
GH_TOKEN=

# Optional: trace every agent call in Logfire (install with `.[logfire]`)
LOGFIRE_TOKEN=

# Optional: webhooks (POST /api/hooks/<provider>?token=...) are off until this is set
FACTORY_TOKEN=

# Optional: the sqs lane (`factory submit`, `factory worker`), with the usual AWS credentials
FACTORY_QUEUE_URL=
AWS_REGION=
